{
  "name": "@crosscode/gravity-components",
  "version": "0.10.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A drop-in, fully themed admin UI kit built on Ant Design v6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme.d.cts",
        "default": "./dist/theme.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "vp lint",
    "format": "vp fmt",
    "verify": "vp check",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "size": "size-limit",
    "check-size": "size-limit --why"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "25 kB",
      "ignore": [
        "@ant-design/icons"
      ]
    },
    {
      "path": "dist/theme.js",
      "limit": "5 kB"
    }
  ],
  "peerDependencies": {
    "antd": ">=6.0.0 <7.0.0",
    "dayjs": ">=1.11.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "recharts": ">=3.0.0 <4.0.0",
    "sonner": ">=2.0.0 <3.0.0",
    "styled-components": ">=6.0.0"
  },
  "keywords": [
    "react",
    "antd",
    "ant-design",
    "admin",
    "component-library",
    "design-system",
    "ui-kit",
    "typescript",
    "sonner",
    "toast",
    "notifications"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cross13/gravity-components.git"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "antd": "^6.7.2",
    "dayjs": "^1.11.23",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.81.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "size-limit": "^12.0.1",
    "sonner": "^2.0.8",
    "storybook": "^10.6.9",
    "styled-components": "^6.7.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "overrides": {
    "vite": "$vite",
    "storybook": {
      "vite-plus": "$vite-plus"
    }
  }
}
